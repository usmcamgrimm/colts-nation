<header class="bg-speed-blue text-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col justify-center">
    <div class="flex flex-col items-center mb-4">
      <div class="p-2 flex items-center justify-center">
        <%= link_to image_tag("horseshoe_2.webp", class: "h-16 w-auto object-contain"), root_path %>
      </div>
      <h1 class="font-title text-4xl lg:text-5xl tracking-wide text-white mt-2">Indianapolis Colts</h1>
    </div>

    <nav>
      <ul class="flex justify-center space-x-6">
        <li>
          <%= link_to "Players", players_path, class: "font-title text-white text-xl lg:text-2xl hover:underline font-medium transition-colors duration-200 py-2 px-3" %>
        </li>
        <li>
          <%= link_to "Schedule", seasons_path, class: "font-title text-white text-xl lg:text-2xl hover:underline font-medium transition-colors duration-200 py-2 px-3" %>
        </li>
      </ul>
    </nav>
    
  </div>
</header>