<header class="bg-blue-900 text-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row justify-between items-center">
    <div class="flex items-center space-x-4 mb-4 sm:mb-0">
      <div class="w-12 h-12 flex items-center justify-center bg-white rounded-full p-2 shadow">
        <%= link_to image_tag("horseshoe_2.webp", class: "horseshoe h-8 w-auto object-contain"), root_path %>
      </div>
      <h1 class="text-2xl tracking-wide text-white">Indianapolis Colts</h1>
    </div>

    <nav>
      <ul class="flex space-x-6">
        <li>
          <%= link_to "Players", players_path, class: "text-gray-200 hover:text-white font-medium transition-colors duration-200 py-2 px-3 rounded-lg hover:bg-blue-800" %>
        </li>
        <li>
          <%= link_to "Schedule", seasons_path, class: "text-gray-200 hover:text-white font-medium transition-colors duration-200 py-2 px-3 rounded-lg hover:bg-blue-800" %>
        </li>
      </ul>
    </nav>
    
  </div>
</header>